# FreeBox Production Environment Configuration
PORT=5005
DATABASE_URL="file:/app/data/dev.db"
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptographically Secure JWT Secret Key (Generate a random 64-char string for production)
JWT_SECRET=your_super_strong_random_jwt_secret_key_here

# Telegram MTProto Official Registered App Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
